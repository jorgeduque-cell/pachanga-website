# ============================================
# Backend - Variables de Entorno
# ============================================

# Base de datos (Supabase)
# Connection Pooler — REQUIERE ?pgbouncer=true para Prisma
DATABASE_URL="postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-1-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# URL directa (para migraciones de Prisma — port 5432, NO pooler)
DIRECT_URL="postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-1-us-east-2.pooler.supabase.com:5432/postgres"_para_produccion

# JWT Secret (mínimo 64 caracteres en producción)
JWT_SECRET=tu_secreto_muy_largo_y_seguro_de_al_menos_64_caracteres_para_produccion

# Puerto (Render usa generalmente 10000)
PORT=3001

# Entorno
NODE_ENV=production

# URL del frontend (para CORS y QR)
FRONTEND_URL=https://pachanga-frontend.vercel.app
CORS_ORIGIN=https://pachanga-frontend.vercel.app,https://pachanga-admin.vercel.app

# ============================================
# WhatsApp Cloud API (opcional)
# ============================================
WHATSAPP_TOKEN=tu_token_de_whatsapp
WHATSAPP_PHONE_ID=tu_phone_id
WHATSAPP_BUSINESS_ID=tu_business_id
WHATSAPP_VERIFY_TOKEN=pachanga_webhook_2026
WHATSAPP_API_VERSION=v21.0
WHATSAPP_DRY_RUN=false
WHATSAPP_APP_SECRET=tu_app_secret_de_meta

# ============================================
# Chatbot IA — Motor OpenRouter + Economía de Tokens
# ============================================
CHATBOT_ENABLED=true
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Modelos (slugs REALES de OpenRouter — verifica el vigente en openrouter.ai/models)
CHATBOT_MODEL=google/gemini-2.5-flash-lite
CHATBOT_ROUTER_MODEL=google/gemini-2.5-flash-lite

# Límites de salida y contexto
CHATBOT_MAX_TOKENS=500
CHATBOT_TEMPERATURE=0.7
CHATBOT_CONTEXT_WINDOW=15
CHATBOT_CONFIDENCE_THRESHOLD=0.7
CHATBOT_ADMIN_PHONE=+573124183002

# Compra de boletas: DESACTIVADA por defecto. El bot solo informa eventos/
# precios y redirige al WhatsApp de ventas. Poner 'true' para reactivar el
# flujo automatizado (recolección de datos + comprobante + verificación IA).
CHATBOT_PURCHASE_ENABLED=false
# Número de ventas: recibe compras, cumpleaños y las alertas de reservas de mesa.
CHATBOT_SALES_PHONE=+573132891788

# Visión (lectura de comprobantes) — sigue en OpenAI GPT-4o. Opcional.
OPENAI_API_KEY=

# ── Economía de Tokens:  CT(x)=c·x+k/x  →  x*=√(k/c) ──
# Precios por 1M tokens (cópialos de la página del modelo en OpenRouter)
TOKENECON_RESPONDER_COST_PER_MTOK=0.10      # c = entrada del respondedor
TOKENECON_RESPONDER_OUT_COST_PER_MTOK=0.40  # salida del respondedor
TOKENECON_ROUTER_COST_PER_MTOK=0.10
TOKENECON_ROUTER_OUT_COST_PER_MTOK=0.40
# Negocio:  k = p_ref · x_ref · C_error
TOKENECON_ERROR_RATE=0.15                    # p_ref = % de respuestas que hoy requieren corrección
TOKENECON_REF_CONTEXT_TOKENS=900             # x_ref = tokens de contexto donde mediste p_ref
TOKENECON_ERROR_COST_USD=0.50                # C_error = USD/min del analista × min por corrección
# Recorte del óptimo (protege el margen)
TOKENECON_MIN_TOKENS=300
TOKENECON_MAX_TOKENS=2000
# Interruptor del pilar de enrutamiento
TOKENECON_ROUTER_ENABLED=true                # pilar 1: triage barato + deflexión
